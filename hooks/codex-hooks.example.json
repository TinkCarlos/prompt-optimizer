{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.agents/hooks/prompt-optimizer-hook.js codex",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.agents/hooks/prompt-optimizer-hook.js codex",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
