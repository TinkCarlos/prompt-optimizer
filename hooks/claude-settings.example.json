{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.agents/hooks/prompt-optimizer-hook.js claude",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.agents/hooks/prompt-optimizer-hook.js claude",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
